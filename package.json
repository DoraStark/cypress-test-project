  "bugs": {
    "url": "https://github.com/DoraStark/cypress-test-project/issues"
  },
  "homepage": "https://github.com/DoraStark/cypress-test-project#readme",
  "devDependencies": {
    "cypress": "^15.3.0"
  }
}
